# syntax=docker/dockerfile:1.7
# Angular.web image for the Azure DevOps pipeline (.azure/). Build context = repository root:
#   docker build -f .azure/docker/Dockerfile.frontend --build-arg APP_VERSION=20260928.1 -t angular-web .
# The root ./Dockerfile belongs to the GitHub Actions workflows and is left unchanged.

# ── Stage 1: build with Node ───────────────────────────────────────────────────
FROM node:22-alpine AS build
WORKDIR /app

# Install first so the dependency layer is cached until the lockfile changes.
COPY angular.web/package.json angular.web/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY angular.web/ ./
RUN npx ng build --configuration production

# ──  Stage 2: serve the static bundle with nginx, as a non-root user ────────────
# nginx-unprivileged runs as uid 101 and listens on 8080 (non-root can't bind port 80).
FROM nginxinc/nginx-unprivileged:1.30-alpine AS runtime

COPY .azure/docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY .azure/docker/nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
# Runs at container start (the base image's entrypoint executes /docker-entrypoint.d/*.sh):
# writes config.json from APP_ENVIRONMENT / API_BASE_URL, so one image serves every environment.
COPY --chmod=0755 .azure/docker/nginx/40-runtime-config.sh /docker-entrypoint.d/40-runtime-config.sh
COPY --from=build --chown=101:101 /app/dist/angular.web/browser /usr/share/nginx/html

# The build number is baked in: the version the SPA reports is the image's, not a deploy setting.
ARG APP_VERSION=dev
ENV APP_VERSION=${APP_VERSION}
LABEL org.opencontainers.image.title="angular-web" \
      org.opencontainers.image.version="${APP_VERSION}"

USER 101
EXPOSE 8080
# No HEALTHCHECK: Container Apps ignores it. Liveness is GET / and version is GET /config.json,
# both probed by the pipeline's post-deploy check (.azure/scripts/deploy-containerapps.sh).
